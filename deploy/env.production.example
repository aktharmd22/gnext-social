# ==============================================================================
# GnextSocial - production environment for shared hosting
#
# Copied to .env by deploy/install.sh. Fill in the database block and APP_URL,
# then re-run the installer.
#
# Nothing that an admin can change at runtime belongs here. The Meta App ID and
# secret live in the app_credentials table, encrypted, and are entered through
# Settings > Meta app.
# ==============================================================================

APP_NAME=GnextSocial
APP_ENV=production

# Left empty on purpose: install.sh runs `artisan key:generate`.
#
# This key encrypts every stored Meta access token. Replacing it does not
# invalidate the tokens, it makes them undecryptable -- every Page has to be
# reconnected. Back it up somewhere other than this server.
APP_KEY=

# Never true in production. With debug on, an unhandled exception renders the
# stack trace, which includes environment variables -- the database password
# and APP_KEY among them.
APP_DEBUG=false

# Must be https. Meta refuses a non-HTTPS OAuth redirect URI, so Page
# connection fails outright over http.
APP_URL=https://gnextsocial.gnext.space

# Timestamps are stored UTC everywhere. This is only what an unconfigured user
# sees them rendered in.
APP_TIMEZONE=UTC
GNEXT_DEFAULT_TIMEZONE=Asia/Dubai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ------------------------------------------------------------------ database --
# From hPanel > Databases > MySQL. The user must be granted on this database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------------- runtime --
# database, not redis: shared hosting has no Redis, and Horizon needs pcntl.
# Jobs are written driver-agnostic, so moving to Redis later is this line plus
# QUEUE_CONNECTION.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# --------------------------------------------------------------------- mail --
# Used for approval requests, failure alerts and the weekly digest. Create the
# mailbox in hPanel > Emails first.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------------- media --
GNEXT_MEDIA_DISK=public
GNEXT_MEDIA_MAX_BYTES=524288000

# Where uploaded media is written.
#
# This host disables PHP's symlink(), so `artisan storage:link` cannot work.
# Rather than depend on a link that may silently not exist, the disk writes
# straight into a real directory inside the web root. That matters because Meta
# fetches every image and video by URL: unreachable media is not a broken
# thumbnail, it is every publish failing at the last step.
#
# install.sh sets this for you. It must stay inside public_html.
GNEXT_PUBLIC_DISK_ROOT=

# If ffprobe is absent the app degrades on purpose: images publish normally,
# but video duration and dimensions cannot be checked before publishing, so a
# Reel outside Meta's specs is caught by Meta instead of by the composer.
# If the host does provide them, put the absolute paths here.
GNEXT_FFMPEG_PATH=ffmpeg
GNEXT_FFPROBE_PATH=ffprobe

# ---------------------------------------------------------------- publishing --
# How far back gnext:recover-missed will reach. Cron can miss a window when the
# host is busy; six hours covers an overnight outage without republishing
# yesterday's content.
GNEXT_RECOVERY_WINDOW_HOURS=6
GNEXT_IG_CONTAINER_POLL_TIMEOUT=300
GNEXT_TOKEN_WARN_DAYS=14,7

# Leave unset. It exists so the publish path can be pointed at a stand-in for a
# rehearsal; in production it must be the real Graph API.
# GNEXT_GRAPH_BASE_URL=
