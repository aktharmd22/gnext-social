APP_NAME=GnextSocial
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gnextsocial
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- GnextSocial -------------------------------------------------------------
# Everything an admin should be able to change at runtime lives in the
# app_credentials table, not here. These are deployment facts only.

# Timestamps are stored UTC; this is what unconfigured users see them in.
GNEXT_DEFAULT_TIMEZONE=Asia/Dubai

# Media ingestion. 500MB cap per the brief; Meta fetches from GNEXT_MEDIA_DISK.
GNEXT_MEDIA_DISK=public
GNEXT_MEDIA_MAX_BYTES=524288000
GNEXT_FFMPEG_PATH=ffmpeg
GNEXT_FFPROBE_PATH=ffprobe

# Publishing safety rails.
GNEXT_RECOVERY_WINDOW_HOURS=6
GNEXT_IG_CONTAINER_POLL_TIMEOUT=300
GNEXT_TOKEN_WARN_DAYS=14,7

# Queue driver is env-switched: `database` on Windows (no Redis, and Horizon
# needs pcntl), `redis` + Horizon in production on Linux. Jobs are written
# driver-agnostic so this is the only line that changes.
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
